# ========================================================
# IMPÉRIO DO STROGONOFFE — CONFIGURAÇÕES DE SERVIÇO & ANOTA AI
# ========================================================
# As credenciais abaixo são estritamente de servidor e NUNCA
# devem ser expostas no código cliente/frontend.
# ========================================================

# Porta da API do servidor de integração
PORT=3001

# Ambiente de integração com Anota AI: 'sandbox' ou 'production'
ANOTA_ENVIRONMENT=sandbox

# Host da API de Parceiros do Anota AI
ANOTA_API_URL=https://gateway-partners.anota.ai

# ID da Loja/Estabelecimento no Anota AI (Header obrigatório x-page-id)
ANOTA_PAGE_ID=placeholder_page_id_imperio

# Credenciais OAuth 2.0 de Parceiro Anota AI
ANOTA_CLIENT_ID=placeholder_client_id
ANOTA_CLIENT_SECRET=placeholder_client_secret

# Token estático de integração (quando utilizado token direto de loja)
ANOTA_API_TOKEN=placeholder_token_opcional

# ========================================================
# GOOGLE MAPS — CÁLCULO DE DISTÂNCIA DE ENTREGA
# ========================================================
# Chave de API do Google Cloud com a "Distance Matrix API" ativada
# (Google Cloud Console → APIs & Services → Credentials).
# Restrinja a chave por IP do servidor (não por domínio, pois é usada no backend).
GOOGLE_MAPS_API_KEY=placeholder_google_maps_api_key

# Endereço completo do restaurante (ponto de origem do cálculo de distância)
RESTAURANT_ORIGIN_ADDRESS=placeholder_endereco_do_restaurante
